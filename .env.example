# Promplate Demo backend url
PROMPLATE_DEMO_BASE_URL=
# Your API Key for OpenAI
OPENAI_API_KEY=
# Custom base url for OpenAI API. default: https://api.openai.com
OPENAI_API_BASE_URL=
# Custom base url for transcription API. If not set, uses OPENAI_API_BASE_URL
# Groq: https://api.groq.com/openai/v1
# SambaNova: https://api.sambanova.cloud/v1
TRANSCRIPT_BASE_URL=
# Whisper model for transcription. default: whisper-1
# Examples: whisper-1, gpt-4o-mini-transcribe, whisper-large-v3-turbo (Groq)
TRANSCRIPT_MODEL=
# Inject analytics or other scripts before </head> of the page
HEAD_SCRIPTS=
# Secret string for the project. Use for generating signatures for API calls
SECRET_KEY=
# Initial model before user specify.
PUBLIC_DEFAULT_MODEL=
# url of the tutorial markdown file
TUTORIAL_MD_URL=
# url of the advertisement iframe
PUBLIC_IFRAME_URL=
# user-agent for backend requests
UNDICI_UA=
# whether your messages should be right-aligned
PUBLIC_RIGHT_ALIGN_MY_MSG=
# how much millisecond between moderations
PUBLIC_MODERATION_INTERVAL=